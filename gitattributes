# ===========================================================================
# 3. Vendored trees are never counted (Part II section 73.8)
# ===========================================================================
vendor/**             linguist-vendored=true
third_party/**        linguist-vendored=true
**/node_modules/**    linguist-vendored=true

# ===========================================================================
# 4. Generated code is never counted (Part II section 73.8)
#    Includes guard-AST codegen output and every wasm build product.
#    Rust-to-wasm is a build target, not an authored language
#    (Part II section 73.1, Tier D negative requirements).
# ===========================================================================
rust/kernel/src/guards_generated.rs   linguist-generated=true
rust/sim/src/guards_generated.rs      linguist-generated=true
frontend/src/api/generated/**         linguist-generated=true
**/generated/**                       linguist-generated=true
**/*.wasm                             linguist-generated=true binary
artifacts/**                          linguist-generated=true

# ===========================================================================
# 5. Documentation and fixtures are not the product (Part II section 73.8)
# ===========================================================================
docs/**              linguist-documentation=true
fixtures/**          linguist-detectable=false
# The committed fixture tree also lives at data/fixtures/ (Part I section 32.2).
# gitattributes patterns containing a slash are root-anchored, so the line above
# does not reach it. This line does.
data/fixtures/**     linguist-detectable=false

# ===========================================================================
# 6. The single permitted linguist-language= override (Part II section 73.8)
# ===========================================================================
# Misdetection corrected: Linguist classifies .wat as plain text, but
# wasm/preimage/ holds hand-authored WebAssembly text format, which is authored
# source. The compiled .wasm in section 4 stays generated and uncounted.
wasm/preimage/*.wat  linguist-language=WebAssembly

# ===========================================================================
# 7. Data-shaped artifacts that must never colour the bar (Part II section 73.8)
# ===========================================================================
*.jsonl              linguist-generated=true
*.pcap               binary
golden/**            linguist-generated=true
data/golden/**       linguist-generated=true
tests/golden/**      linguist-generated=true

# ===========================================================================
# 8. Byte-exact artifacts: never normalise, never diff (Part II section 74.10.5)
#    These lines come LAST because the last matching pattern wins, and byte
#    identity outranks line-ending normalisation for anything that is hashed.
#
#    TODO(decision): Part II section 73.8 lists `*.cert.json text eol=lf` and
#    `*.golden text eol=lf`, while Part II section 74.10.5 lists
#    `**/*.cert.json -text` and `tests/golden/** -text -diff`. Both are Part II.
#    Resolved in favour of -text, because a certificate or golden file is
#    compared byte-for-byte and gate G-WIN-004 already proves every
#    text-classified file is w/lf, so normalisation buys nothing and can only
#    corrupt a hash. To reverse: delete this block and keep the section 73.8
#    spellings that open it.
# ===========================================================================
*.golden               text eol=lf
*.cert.json            text eol=lf
tests/golden/**        -text -diff
data/golden/**         -text -diff
**/*.cert.json         -text
**/*.expected          -text
cas/**                 -text -diff filter=

*.tar.zst    binary
*.tar        binary
*.zst        binary
*.gz         binary
*.png        binary
*.jpg        binary
*.ico        binary
*.pdf        binary
*.woff       binary
*.woff2      binary
*.jar        binary
*.so         binary
*.a          binary
*.o          binary
*.dll        binary
*.dylib      binary
*.blake3     binary

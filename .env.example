# SPECTRA - example environment file
#
# Copy to .env and edit. .env is git-ignored; this file is committed and is the
# only documentation of what each variable does.
#
# Status: not started. Nothing reads these yet. Every variable below is declared
# for the component that will read it, named in the comment above it.
#
# RULE: no secret, credential, token or password value is ever committed to this
# file, not even a fake one that looks real. Placeholder values here are
# obviously non-functional on purpose, so that a committed real value is visible
# as an anomaly in review rather than camouflaged among plausible ones.

# --------------------------------------------------------------------------
# Determinism. Read by every target via the Makefile.
# --------------------------------------------------------------------------
# These are exported by the Makefile regardless; setting them here documents
# that nothing may depend on a host locale or timezone.
TZ=UTC
LC_ALL=C

# --------------------------------------------------------------------------
# Database. Read by the API and the worker (M2 onward).
# --------------------------------------------------------------------------
# The kernel and the checker never read these: they are pure file-in/file-out
# binaries with no service dependency, per ADR-0005. If either ever needs a
# database URL, the offline-verification claim has been broken.
SPECTRA_PG_HOST=localhost
SPECTRA_PG_PORT=5432
SPECTRA_PG_DATABASE=spectra
SPECTRA_PG_USER=spectra
SPECTRA_PG_PASSWORD=CHANGE-ME-NOT-A-REAL-PASSWORD

# --------------------------------------------------------------------------
# Redis. Ephemeral job state only (M3 onward).
# --------------------------------------------------------------------------
# Nothing durable lives here. A value that cannot be recomputed must not be
# stored in Redis.
SPECTRA_REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# Artifact store. Content-addressed files on disk (M1 onward).
# --------------------------------------------------------------------------
SPECTRA_DATA_ROOT=./data
SPECTRA_RUNS_ROOT=./data/runs

# --------------------------------------------------------------------------
# Narration. Optional, off by default (M8 onward).
# --------------------------------------------------------------------------
# The narrator consumes a certificate and nothing else. Every gate, test and
# benchmark must stay green with it absent, which `make verify-no-llm` proves.
# There is no API key variable here and there will not be one: narration runs
# against a local model or not at all.
SPECTRA_NARRATION_ENABLED=0
SPECTRA_NARRATION_MODEL_PATH=

# --------------------------------------------------------------------------
# Development.
# --------------------------------------------------------------------------
# Set to 1 only from inside the devcontainer. Setting it on a bare Windows host
# defeats the guard described in docs/dev/wsl.md and will produce results that
# do not reproduce elsewhere.
SPECTRA_DEVCONTAINER=0

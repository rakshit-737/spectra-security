# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
# .env.example IS committed and documents every variable. A real .env is not.
.env
.env.*
!.env.example
*.pem
*.key
!tests/**/*.key
credentials.env


# SPECTRA - .editorconfig
#
# Status: session one. This file is the thing being delivered.
#
# Whitespace and newline policy, enforced in CI (Part I section 32.2).
# It must agree with .gitattributes: LF everywhere except *.bat and *.cmd
# (Part II section 74.10.5), UTF-8 everywhere, no trailing whitespace, and a
# final newline on every text file.
#
# TODO(decision): the specification fixes the line-ending and encoding policy
# but leaves indent width per language open. The widths below are each
# language's community default, chosen so that no formatter in `make fmt`
# has to be configured against this file. If a formatter's default ever
# disagrees, change the formatter config and this file in the same commit;
# `make lint` must stay the single source of truth.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ---------------------------------------------------------------------------
# Tier A - critical path
# ---------------------------------------------------------------------------
[*.py]
indent_size = 4
max_line_length = 100

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

[*.sql]
indent_size = 2

[*.{sh,bash,bats}]
indent_size = 2
# shfmt is configured to match; see tools/lint/.

# ---------------------------------------------------------------------------
# Tier B - oracles and measured performance
# ---------------------------------------------------------------------------
[*.{hs,lhs}]
indent_size = 2

[*.cabal]
indent_size = 2

[*.{c,h,cc,cpp,hpp}]
indent_size = 2

[*.java]
indent_size = 4

[*.cs]
indent_size = 4

[*.{s,S,asm,inc}]
indent_size = 8
# NASM source: mnemonic column at 8 keeps hand-authored listings aligned.

# ---------------------------------------------------------------------------
# Tier C - heterogeneous observed estate
# ---------------------------------------------------------------------------
[*.php]
indent_size = 4

[*.{rb,rake}]
indent_size = 2

[*.{pl,pm,t}]
indent_size = 4

[*.lua]
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.swift]
indent_size = 4

[*.{m,mm}]
indent_size = 4

[*.dart]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{groovy,gradle}]
indent_size = 4

[*.{scala,sbt}]
indent_size = 2

# ---------------------------------------------------------------------------
# Tier D - research and formal artifacts
# ---------------------------------------------------------------------------
[*.{R,r,Rmd}]
indent_size = 2

[*.jl]
indent_size = 4

[*.{fs,fsx,fsproj}]
indent_size = 4

[*.sol]
indent_size = 4

[*.{v,sv,svh}]
indent_size = 2

[*.{vhd,vhdl}]
indent_size = 2

[*.wat]
indent_size = 2

[*.{yar,yara}]
indent_size = 4

# ---------------------------------------------------------------------------
# Configuration and markup formats (Part II section 73.2)
# ---------------------------------------------------------------------------
[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.xml]
indent_size = 2

[*.html]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[{Dockerfile,*.Dockerfile}]
indent_size = 4

[{Makefile,*.mk,makefile,GNUmakefile}]
indent_style = tab
indent_size = 4
# Recipe lines require a literal tab. Never let an editor expand these.

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{tf,hcl}]
indent_size = 2

# ---------------------------------------------------------------------------
# Documentation and data
# ---------------------------------------------------------------------------
[*.md]
indent_size = 2
trim_trailing_whitespace = false
# Markdown hard line breaks are two trailing spaces; trimming them rewrites prose.
max_line_length = 100

[*.{tex,bib}]
indent_size = 2

[*.{csv,tsv}]
trim_trailing_whitespace = false
insert_final_newline = true

# ---------------------------------------------------------------------------
# Byte-exact artifacts: never rewritten by an editor
# ---------------------------------------------------------------------------
# These are hashed and compared byte-for-byte. .gitattributes marks them -text;
# this stops an editor doing what git was told not to do.
[{data/golden/**,tests/golden/**,cas/**}]
insert_final_newline = unset
trim_trailing_whitespace = false
charset = unset
end_of_line = unset

[*.{golden,expected,jsonl}]
insert_final_newline = unset
trim_trailing_whitespace = false

[*.cert.json]
insert_final_newline = unset
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# The only CRLF exception (Part II section 74.10.5)
# ---------------------------------------------------------------------------
[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

# ---------------------------------------------------------------------------
# Vendored and generated trees are not ours to reformat
# ---------------------------------------------------------------------------
[{vendor/**,third_party/**,**/node_modules/**,**/generated/**,artifacts/**}]
indent_size = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset
